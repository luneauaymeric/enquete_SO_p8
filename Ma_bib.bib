@book{kahnemanThinkingFastSlow2013,
  title = {Thinking, Fast and Slow},
  author = {Kahneman, Daniel},
  year = 2013,
  edition = {1st pbk. ed},
  publisher = {{Farrar, Straus and Giroux}},
  address = {New York},
  abstract = {In this work the author, a recipient of the Nobel Prize in Economic Sciences for his seminal work in psychology that challenged the rational model of judgment and decision making, has brought together his many years of research and thinking in one book. He explains the two systems that drive the way we think. System 1 is fast, intuitive, and emotional; System 2 is slower, more deliberative, and more logical. He exposes the extraordinary capabilities, and also the faults and biases, of fast thinking, and reveals the pervasive influence of intuitive impressions on our thoughts and behavior. He reveals where we can and cannot trust our intuitions and how we can tap into the benefits of slow thinking. He offers practical and enlightening insights into how choices are made in both our business and our personal lives, and how we can use different techniques to guard against the mental glitches that often get us into trouble. This author's work has transformed cognitive psychology and launched the new fields of behavioral economics and happiness studies. In this book, he takes us on a tour of the mind and explains the two systems that drive the way we think and the way we make choices},
  isbn = {978-0-374-53355-7},
  lccn = {BF441 .K238 2013},
  keywords = {Decision making,Intuition,Reasoning,Thought and thinking}
}

@article{kamounMultipleChemicalSensitivity2011,
  title = {{Multiple chemical sensitivity syndrome. Observation of a cohort of 20 workers}},
  shorttitle = {{Le syndrome d'intol\'erance aux odeurs chimiques. Observation d'une cohorte de 20 salari\'es}},
  author = {Kamoun, H. and Romdhane, N.A. and Rekik, W. and Laadheri, N. and Youssef, I. and Ben Salah, F. and Gharbi, R.},
  year = 2011,
  journal = {Archives des Maladies Professionnelles et de l'Environnement},
  volume = {72},
  number = {1},
  pages = {73--79},
  issn = {17758785 (ISSN)},
  doi = {10.1016/j.admp.2010.08.006},
  abstract = {Objectives: Multiple Chemical Sensitivity syndrome (MCS) is defined as a group of non-specific symptoms presented by a person chronically exposed to low concentrations of various chemicals. Its diagnosis and treatment are difficult. The effect of avoidance measures is uncertain. This study aims to describe MCS in occupational environment and to evaluate the effect of avoidance on its symptoms and on the future of the workers. Methods: Two successive surveys have allowed the description of MCS (20 cases) and the evaluation of avoidance recommendation (16 cases). The questionnaire is derived from the "Quick Environmental exposure and Sensitivity Inventory" (QEESI\copyright ). Diagnosis has been established according to the 1999 consensus. Median (minimum-maximum), Mann-Whitney and Kaplan-Meier survival analyses have been performed. Results: The median duration of exposure to chemical odours is 14.5 years (2-41). It is shorter (P = 0.039) for women 9.5 years (2-20) than for men 20.5 years (9-41). The median duration of MCS signs is 8.5 years (0-32). Only 44\% of workers have benefited from avoidance. Symptoms have disappeared in 31\% of the workers. The lower the initial number of MCS symptoms, the higher the disappearance frequency (P = 0.019). Early avoidance seems in favor of MCS symptoms disappearance (Log Rank P = 0.002). The probability of MCS symptoms disappearance, in the case of maintained exposure, is close to zero. In the case of avoidance, the shorter the duration of MCS signs, the higher the probability of symptoms disappearance. The probability is equal to 0.86 for a duration {$\leq$} 1 year, to 0.57 for a duration {$\leq$} 2 years, to 0.43 for a duration {$\leq$} 3 years, to 0.29 for a duration {$\leq$} 4 years and equivalent to 0 for a duration {$\geq$} 5 years. Conclusion: Our study has verified the reality of MCS as a pathological entity. In occupational environment, early avoidance seems to constitute an effective preventive action. However, these results have to be confirmed on a larger population. \copyright{} 2010 Elsevier Masson SAS. All rights reserved.},
  langid = {french},
  keywords = {Multiple chemical sensitivities (MCS),occupational exposure,Organic solvents}
}

@article{kastoraComprehendingImpactBreastcancer2023,
  title = {Comprehending the Impact of \#{{Breastcancer}}, \#{{Breastsurgery}} and Related Hashtags on {{Twitter}}: {{A}} Content and Social Network Cross-Sectional Analysis \#{{Breastcancer}}\#{{Breastsurgery}}},
  shorttitle = {Comprehending the Impact of \#{{Breastcancer}}, \#{{Breastsurgery}} and Related Hashtags on {{Twitter}}},
  author = {Kastora, Stavroula L. and Karakatsanis, Andreas and Masannat, Yazan A.},
  year = 2023,
  month = apr,
  journal = {European Journal of Surgical Oncology},
  volume = {49},
  number = {4},
  pages = {716--723},
  issn = {0748-7983},
  doi = {10.1016/j.ejso.2023.01.016},
  urldate = {2024-11-21},
  abstract = {Background Early detection along with improved locoregional and systemic therapies have decreased breast cancer mortality and allowed for the clinical implementation of breast conserving surgical options, in turn reducing the clinical and psychosocial impact of mastectomy. To what extend this has been successfully conveyed through social media for breast cancer awareness, has not been previously investigated. Methods This study presents a content and social network cross-sectional descriptive study of Twitter and Google trends data worldwide from platform launch (2006 and 2004 respectively) until May 15th, 2022, in agreement with the STROBE guidelines. Tweets associated with the hashtags \#Breastcancer, \#Breastsurgery, \#Oncoplasticsurgery, \#Mastectomy, \#Breastreconstruction, \#Breastconservingsurgery were licensed and downloaded through the Vincitas and Tweetbinder online platforms. Associated available demographics, namely username, biography, location, date and language of post, were extracted from the Twitter dataset while interest percentage, location and language of search were extracted from the Google trends dataset. Results A total of 390111 unique tweets were generated by 127284 unique users, with 2 users engaging with all six hashtags. Original tweets constituted on average 39.1\% [Min 30.7\% to max 47.2\%] of the total. Hashtag frequency increased on Twitter for all six searches during October, the breast-cancer awareness month, but not on Google trends. Cancer survivors engaged much more often with the hashtag \#Breastcancer and \#Mastectomy, whereas \#Breastsurgery, \#Oncoplasticsurgery, \#Breastconservingsurgery, \#Breastreconstruction were mostly used by health professionals. Conclusion In this large qualitative and quantitative dataset, geo-temporal oscillations on Twitter and Google trends for hashtags relevant with breast cancer provide preliminary insights on information flow and user engagement. Understanding the effective use of social media platforms may provide the niche for disseminating evidence and promoting education on the surgical options of patients with breast cancer.},
  file = {/home/aymeric/Zotero/storage/Q6QL5QXE/Kastora et al. - 2023 - Comprehending the impact of #Breastcancer, #Breastsurgery and related hashtags on Twitter A content.pdf;/home/aymeric/Zotero/storage/8YJZ3VN7/S0748798323000823.html}
}

@article{katzDiseaseSpecificHashtagsOnline2016,
  title = {Disease-{{Specific Hashtags}} for {{Online Communication About Cancer Care}}},

@article{carelLargumentationDansDiscours1994,
  title = {{L'argumentation dans le discours : argumenter n'est pas justifier}},
  shorttitle = {{L'argumentation dans le discours}},
  author = {Carel, Marion},
  year = 1994,
  journal = {Langage \& soci\'et\'e},
  volume = {70},
  number = {1},
  pages = {61--81},
  publisher = {Pers\'ee - Portail des revues scientifiques en SHS},
  doi = {10.3406/lsoc.1994.2677},
  urldate = {2021-01-05},
  abstract = {Les argumentations du discours quotidien sont g\'en\'eralement analys\'ees comme des proc\'edures de d\'emonstration. Parfois floues dans leurs termes, ou incompl\`etes dans leurs pr\'emisses, elles garderaient tout de m\^eme la structure des d\'emonstrations math\'ematiques : l'enjeu serait d'\'etablir, \`a partir d'un argument interpr\'et\'e et justifiable en lui-m\^eme, la v\'erit\'e de la conclusion. En fait, l'usage naturel de donc diff\`ere, non qualitativement, mais structureUement de son usage math\'ematique. L'argument et la conclusion ne peuvent s'interpr\'eter ind\'ependamment. L'argumentation discursive n'est pas une d\'emonstration lacunaire. De fa\c con positive, argumenter consiste \`a injecter dans le discours des repr\'esentations communes, des lieux communs, inscrits dans la signification m\^eme des mots et d\'evelopp\'es par les encha\^inements. Ainsi comprise, l'argumentation n'a plus pour marque privil\'egi\'ee l'usage de donc : pourtant, sous une autre forme, mais tout aussi directement, permet de r\'ealiser des argumentations.},
  copyright = {free},
  langid = {fre},
  file = {/home/aymeric/Zotero/storage/ZJ3WY754/Carel - 1994 - L'argumentation dans le discours  argumenter n'es.pdf;/home/aymeric/Zotero/storage/D25Z27H9/lsoc_0181-4095_1994_num_70_1_2677.html}
}


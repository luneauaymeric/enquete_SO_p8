@article{pellinoSocialMediaColorectal2017,
  title = {Social Media and Colorectal Cancer: {{A}} Systematic Review of Available Resources},
  shorttitle = {Social Media and Colorectal Cancer},
  author = {Pellino, Gianluca and Simillis, Constantinos and Qiu, Shengyang and Rasheed, Shahnawaz and Mills, Sarah and Warren, Oliver and Kontovounisios, Christos and Tekkis, Paris P.},
  editor = {Attai, Deanna J.},
  year = 2017,
  month = aug,
  journal = {PLOS ONE},
  volume = {12},
  number = {8},
  pages = {e0183031},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0183031},
  urldate = {2024-11-21},
  abstract = {Method Studies published between 2006 and 2016 were assessed. We also assessed the impact of several hashtags on Twitter with a freeware (Symplur). Results Nine studies were included assessing Twitter (78\%), Forums/Cancer-survivor networks (33\%), and Facebook (22\%). Aims included use of SM by CRC patients (67\%), cancerspecific usage of SM with different types of cancer (44\%), content credibility (33\%), and influence in CRC awareness (33\%). Prevention was the most common information that CRC patients looked for, followed by treatment side-effects. Only 2\% of CRC SM users are doctors. SM use by colorectal consultants was suboptimal. Only 38\% of surgeons had a LinkedIn account (most with less than 50 connections), and 3\% used Twitter. A steep increase of tweets was observed for searched Hashtags over time, which was more marked for \#ColonCancer (+67\%vs+38\%, \#Coloncancer vs \#RectalCancer). Participants engaged with colon cancer increased by 85\%, whereas rectal cancer ones increased by 29\%. The hashtag `\#RectalCancer' was mostly tweeted by colorectal surgeons. The official twitter account of American Society of Colorectal Surgeons (@fascrs\_updates) was the most active account. Conclusion CRC patients and relatives are increasingly engaging with SM. CRC surgeons' participation is poor, but we confirm a trend toward a greater involvement. Most SM lack of authoritative validation and the quality of shared content still is largely anecdotic and not scientifically},
  langid = {english},
  keywords = {Cancer treatment,Colorectal cancer,Facebook,Medical journals,Physicians,Social media,Surgeons,Twitter},
  file = {/home/aymeric/Zotero/storage/2RIA2BAE/Pellino et al. - 2017 - Social media and colorectal cancer A systematic review of available resources.pdf;/home/aymeric/Zotero/storage/FZG3ZRZM/Pellino et al. - 2017 - Social media and colorectal cancer A systematic review of available resources.pdf;/home/aymeric/Zotero/storage/RRQ5GT58/Pellino et al. - 2017 - Social media and colorectal cancer A systematic review of available resources.pdf}
}


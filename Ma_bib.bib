@article{daumalinIndustrieEnvironnementProvence2006,
  title = {{Industrie et environnement en Provence sous l'Empire et la Restauration}},
  author = {Daumalin, Xavier},
  year = 2006,
  month = jan,
  journal = {Rives m\'editerran\'eennes},
  number = {23},
  pages = {27--46},
  issn = {2103-4001},
  doi = {10.4000/rives.522},
  urldate = {2014-07-28},
  abstract = {Contrairement \`a certaines id\'ees re\c cues, la probl\'ematique <<~industrie et environnement~>> est bien ant\'erieure \`a la prise de conscience \'ecologique des ann\'ees 1960-1970. D\`es le d\'ebut du xixe si\`ecle, elle appara\^it m\^eme, pour certaines industries tr\`es polluantes, comme un des \'el\'ements majeurs de leur relation avec les soci\'et\'es dans lesquelles elles tentent de se d\'evelopper. C'est le cas, notamment, des usines de soude du littoral proven\c cal fond\'ees sous l'Empire et la Restauration. Vivement contest\'ees par les populations environnantes, r\'eguli\`erement menac\'ees d'\^etre incendi\'ees, condamn\'ees \`a payer des amendes, elles deviennent peu \`a peu l'enjeu d'un rapport de force sp\'ecifique mettant aux prises entrepreneurs, riverains, conseillers municipaux, experts scientifiques et fonctionnaires de l'\'Etat, chaque protagoniste ayant un discours et une posture que l'on pourrait, \`a peu de choses pr\`es, et toute proportion gard\'ee, retrouver de nos jours \`a propos de telle ou telle industrie reconnue dangereuse et n\'eanmoins jug\'ee vitale pour l'avenir \'economique et social de la nation.},
  collaborator = {Americi, Laurence and Raveux, Olivier},
  copyright = {\copyright{} Tous droits r\'eserv\'es},
  langid = {french},
  file = {/home/aymeric/Zotero/storage/V2V3ITAQ/Daumalin - 2006 - Industrie et environnement en Provence sous l’Empi.pdf;/home/aymeric/Zotero/storage/5SQ9RHF5/522.html}

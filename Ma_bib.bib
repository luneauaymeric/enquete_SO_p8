  author = {Demeulenaere, {\'E}lise and Rivi{\`e}re, Pierre and Hyacinthe, Alexandre and Baltassat, Rapha{\"e}l and Baltazar, Sofia and Gascuel, Jean-S{\'e}bastien and Lacanette, Julien and Montaz, H{\'e}l{\`e}ne and Pin, Sophie and Ranke, Olivier and {Serpolay-Besson}, Estelle and Thomas, Mathieu and Van Frank, Ga{\"e}lle and Vanoverschelde, Marc and {Vindras-Fouillet}, Camille and Goldringer, Isabelle},

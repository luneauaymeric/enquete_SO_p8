@article{jolyFuturesTechnoscientificPromises2021,
  title = {The Past Futures of Techno-Scientific Promises},
  author = {Joly, Pierre-Benoit and Le Renard, Claire},
  year = 2021,
  month = dec,
  journal = {Science and Public Policy},
  volume = {48},
  number = {6},
  pages = {900--910},
  publisher = {Oxford University Press (OUP)},
  issn = {0302-3427, 1471-5430},
  doi = {10.1093/scipol/scab054},
  urldate = {2025-07-17},
  abstract = {Abstract               Previous studies have shown that techno-scientific promises play key roles in the process of emergence of new technologies. The role of promises in the emergence of old technologies when they were young has, however, been overlooked. The main objective of this paper is to fill this gap. We draw on the concept of `regime of historicity', defined as an organizational structure given societies impose on the experience of time and articulate the present, the past, and the future. Using four case studies, we argue that the way techno-scientific promises align with regimes of historicity is crucial. This paper shows that promising in the presentist regime using the modernist frame of innovation (creative destruction) raises many problems Instead, the building of horizons of hope may rest on promises based on processes of collective experimentation.},
  copyright = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
  langid = {english},

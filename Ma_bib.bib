@article{dupasMultipleChemicalSensitivity2013,
  title = {{Multiple chemical sensitivity: A diagnosis not to be missed}},
  shorttitle = {{Syndrome d'intol\'erance aux odeurs chimiques (SIOC): Un diagnostic \`a ne pas manquer. \'Epid\'emiologie, diagnostic, traitement}},
  author = {Dupas, D. and Dagorne, M.-A.},
  year = 2013,
  journal = {Revue des Maladies Respiratoires},
  volume = {30},
  number = {2},
  pages = {99--104},
  issn = {07618425 (ISSN)},
  doi = {10.1016/j.rmr.2012.06.016},
  abstract = {Multiple chemical sensitivity (MCS) is a chronic condition, which belongs to the group of medically unexplained syndromes. Patients (men as well as women) complain of many subjective symptoms such as nose and mouth irritation, sore throat, dyspnea, tiredness, dizziness, headache and concentration difficulties. Patient typically report at least four or five symptoms occurring when they are exposed to particular substances, at a very low concentration that usually does not cause symptoms or harm in normal individuals. The common feature of products that appear to be responsible (either occupational or domestic) is that they have a strong smell and include: solvent, paint, glue, tar, oil, pesticides, perfume, cosmetics and spray products. MCS is nowadays considered to be one aspect of idiopathic environmental intolerance (IEI) whose other main aspect is hypersensitivity to electromagnetic fields. If the diagnosis is suspected clinically it can be confirmed using the Quick Environmental Exposure and Sensitivity Inventory (QEESI\copyright ) self-questionnaire. MCS is often misdiagnosed as asthma or an allergic conditions which means that patients are frequently referred to respiratory and allergy specialists. Misdiagnosis can lead to many futile medical investigations. Psychotherapy can improve quality of life in some cases. Preventive measures are often ineffective and do not stop the condition worsening: hypersensitivity can spread to common environmental odors so that a few people become severely disabled and limited in their workplace as well as in private life. In France, 435 cases were registered in the university hospital occupational disease departments network (RNV3P) during the period 2007-2010. It is therefore important that every clinician be able to recognize the condition and ensure that their patients could get compensation when unable to go on working. \copyright{} 2012 SPLF. Published by Elsevier Masson SAS. All rights reserved.},
  langid = {french},
  keywords = {adult,Allergy,asthma,concentration loss,Diagnosis Differential,diagnostic error,dizziness,dyspnea,environmental exposure,fatigue,female,headache,human,Humans,hypersensitivity,Idiopathic environmental intolerance,Liability Legal,male,middle aged,mouth disease,mouth irritation,Multiple chemical sensitivity,Nasal Provocation Tests,nose irritation,Occupational diseases,occupational exposure,Poisoning,quality of life,questionnaire,Questionnaires,Quick Environmental Exposure and Sensitivity Inventory,review,severity of illness index,Sex Distribution,sore throat,Symptom Assessment}
}

@article{dupasSyndromeDintoleranceAux2013,
  title = {{Syndrome d'intol\'erance aux odeurs chimiques (SIOC): Un diagnostic \`a ne pas manquer. \'Epid\'emiologie, diagnostic, traitement}},
  shorttitle = {{Multiple chemical sensitivity: A diagnosis not to be missed}},
  author = {Dupas, D. and Dagorne, M.-A.},
  year = 2013,
  journal = {Archives des Maladies Professionnelles et de l'Environnement},
  volume = {74},
  number = {3},
  pages = {305--310},
  issn = {17758785 (ISSN)},
  doi = {10.1016/j.admp.2013.03.003},
  abstract = {Multiple chemical sensitivity (MCS) is a chronic condition, which belongs to the group of medically unexplained syndromes. Patients (men as well as women) complain of many subjective symptoms such as nose and mouth irritation, sore throat, dyspnea, tiredness, dizziness, headache and concentration difficulties. Patient typically report at least four or five symptoms occurring when they are exposed to particular substances, at a very low concentration that usually does not cause symptoms or harm in normal individuals. The common feature of products that appear to be responsible (either occupational or domestic) is that they have a strong smell and include: solvent, paint, glue, tar, oil, pesticides, perfume, cosmetics and spray products. MCS is nowadays considered to be one aspect of idiopathic environmental intolerance (IEI) whose other main aspect is hypersensitivity to electromagnetic fields. If the diagnosis is suspected clinically it can be confirmed using the Quick Environmental Exposure and Sensitivity Inventory (QEESI\copyright ) self-questionnaire. MCS is often misdiagnosed as asthma or an allergic conditions which means that patients are frequently referred to respiratory and allergy specialists. Misdiagnosis can lead to many futile medical investigations. Psychotherapy can improve quality of life in some cases. Preventive measures are often ineffective and do not stop the condition worsening: hypersensitivity can spread to common environmental odors so that a few people become severely disabled and limited in their workplace as well as in private life. In France, 435 cases were registered in the university hospital occupational disease departments network (RNV3P) during the period 2007-2010. It is therefore important that every clinician be able to recognize the condition and ensure that their patients could get compensation when unable to go on working. \copyright{} 2013 Published by Elsevier Masson SAS.},
  langid = {french},
  keywords = {Idiopathic environmental intolerance,Multiple chemical sensitivity,Occupational diseases}
}


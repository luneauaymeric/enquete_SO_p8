@article{suehnholzQuantifyingExpandingLandscape2024,
  title = {Quantifying the {{Expanding Landscape}} of {{Clinical Actionability}} for {{Patients}} with {{Cancer}}},
  author = {Suehnholz, Sarah P. and Nissan, Moriah H. and Zhang, Hongxin and Kundra, Ritika and Nandakumar, Subhiksha and Lu, Calvin and Carrero, Stephanie and Dhaneshwar, Amanda and Fernandez, Nicole and Xu, Benjamin W. and Arcila, Maria E. and Zehir, Ahmet and Syed, Aijazuddin and Brannon, A. Rose and Rudolph, Julia E. and Paraiso, Eder and Sabbatini, Paul J. and Levine, Ross L. and Dogan, Ahmet and Gao, Jianjiong and Ladanyi, Marc and Drilon, Alexander and Berger, Michael F. and Solit, David B. and Schultz, Nikolaus and Chakravarty, Debyani},
  year = 2024,
  month = jan,
  journal = {Cancer Discovery},
  volume = {14},
  number = {1},
  pages = {49--65},
  issn = {2159-8274},
  doi = {10.1158/2159-8290.CD-23-0467},
  urldate = {2025-03-28},
  abstract = {There is a continuing debate about the proportion of cancer patients that benefit from precision oncology, attributable in part to conflicting views as to which molecular alterations are clinically actionable. To quantify the expansion of clinical actionability since 2017, we annotated 47,271 solid tumors sequenced with the MSK-IMPACT clinical assay using two temporally distinct versions of the OncoKB knowledge base deployed 5 years apart. Between 2017 and 2022, we observed an increase from 8.9\% to 31.6\% in the fraction of tumors harboring a standard care (level 1 or 2) predictive biomarker of therapy response and an almost halving of tumors carrying nonactionable drivers (44.2\% to 22.8\%). In tumors with limited or no clinical actionability, TP53 (43.2\%), KRAS (19.2\%), and CDKN2A (12.2\%) were the most frequently altered genes.Although clear progress has been made in expanding the availability of precision oncology-based treatment paradigms, our results suggest a continued unmet need for innovative therapeutic strategies, particularly for cancers with currently undruggable oncogenic drivers.See related commentary by Horak and Fr\"ohling, p. 18.This article is featured in Selected Articles from This Issue, p. 5},
  file = {/home/aymeric/Zotero/storage/E4QM9RK5/Suehnholz et al. - 2024 - Quantifying the Expanding Landscape of Clinical Actionability for Patients with Cancer.pdf;/home/aymeric/Zotero/storage/N24QTPT5/Quantifying-the-Expanding-Landscape-of-Clinical.html}
}


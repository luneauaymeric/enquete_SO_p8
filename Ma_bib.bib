  doi = {10.3406/rei.1997.1659},
  urldate = {2018-03-08},
  abstract = {L'article \'etudie, d'un point de vue d'historien, le livre de Michael Gibbons et al. Il propose de consid\'erer les modes 1 et 2 de production des savoirs pr\'esent\'es dans l'ouvrage, non comme deux modes effectifs s'\'etant succ\'ed\'es dans le temps, mais comme deux cas limites repr\'esentant des syst\`emes de pratiques ayant \'et\'e pr\'esents en parall\`ele et de longue date. Il insiste sur le fait que les philosophes naturels et les savants des trois derniers si\`ecles ont souvent travaill\'e en conjonction avec le march\'e et l'\'Etat et que ce qui est d\'ecrit comme mode 1 a surtout eu comme fonction de masquer cette int\'egration et de constituer une norme culturelle. Il illustre son propos \`a partir d'exemples puis\'es dans l'historiographie r\'ecente.},
  copyright = {free},

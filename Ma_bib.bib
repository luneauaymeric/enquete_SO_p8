@article{vielSoftTissueSarcomaNonHodgkins2000,
  title = {Soft-{{Tissue Sarcoma}} and {{Non-Hodgkin}}'s {{Lymphoma Clusters}} around a {{Municipal Solid Waste Incinerator}} with {{High Dioxin Emission Levels}}},
  author = {Viel, Jean-Fran{\c c}ois and Arveux, Patrick and Baverel, Josette and Cahn, Jean-Yves},
  year = 2000,
  month = jan,
  journal = {American Journal of Epidemiology},
  volume = {152},
  number = {1},
  pages = {13--19},
  issn = {0002-9262, 1476-6256},
  doi = {10.1093/aje/152.1.13},
  urldate = {2014-10-24},
  abstract = {Overall evidence from epidemiologic studies in the workplace suggests that dioxin is a human carcinogen, but whether low doses affect the general population remains to be determined. The authors examined the spatial distribution of soft-tissue sarcomas and non-Hodgkin's lymphomas around a French municipal solid waste incinerator with high emission levels of dioxin (16.3 ng international toxic equivalency factor/m3). Not consistently associated with dioxin exposure, Hodgkin's disease served as the control cancer category. Clusters were identified from 1980 to 1995 in the area (``d\'epartement'') of Doubs by applying a spatial scan statistic to 26 electoral wards. The most likely and highly significant clusters found were identical for soft-tissue sarcomas and non-Hodgkin's lymphomas and included the area around the municipal solid waste incinerator; standardized incidence ratios were 1.44 (observed number of cases = 45, focused test p value = 0.004) and 1.27 (observed number of cases = 286, focused test p value = 0.00003), respectively. Conversely, Hodgkin's disease exhibited no specific spatial distribution. Confounding by socioeconomic status, urbanization, or patterns of medical referral seemed unlikely to explain the clusters. Although consistent, these findings should be confirmed by further investigation (e.g., a case-control study in which dioxins are measured in biologic tissues) before clusters of soft-tissue sarcoma and non-Hodgkin's lymphoma are ascribed to dioxin released by the municipal solid waste incinerator.},
  langid = {english},
  pmid = {10901325},
  keywords = {2378-TCDD 2378-tetrachlorodibenzo-p-dioxin,245-T 245-trichlorophenoxyacetic acid,cluster analysis,dioxins,I-TEQ international toxic equivalency factor,ICD-O International Classification of Diseases for Oncology,incidence,incineration,lymphoma non-Hodgkin,MSW municipal solid waste,sarcoma,soft tissue neoplasms,waste management},
  file = {/home/aymeric/Zotero/storage/ETK8VW34/Viel et al. - 2000 - Soft-Tissue Sarcoma and Non-Hodgkin's Lymphoma Clu.pdf;/home/aymeric/Zotero/storage/NRIUNHBG/13.html}
}


@article{zolesioChirurgieSaMatrice2012,
  title = {{La chirurgie et sa matrice de socialisation professionnelle}},
  author = {Zolesio, Emmanuelle},
  year = 2012,
  month = nov,
  journal = {Sociologie},
  number = {N{$^\circ$}4, vol. 3},
  publisher = {PUF},
  issn = {2108-8845},
  urldate = {2022-02-11},
  abstract = {Il est possible d'identifier les produits, les modalit\'es de transmission et les effets de la matrice de socialisation professionnelle id\'ealtypique en chirurgie. Elle se caract\'erise par des dispositions socialement construites comme masculines, par des modalit\'es de transmission relativement <<~brutes~>> et brutales, ainsi que par des effets de renforcement des dispositions <<~masculines~>> ant\'erieurement incorpor\'ees, visant \`a confirmer que la socialisation secondaire, dans ce cas, vient renforcer les effets des socialisations ant\'erieures. Il est possible toutefois de nuancer cette matrice id\'ealtypique et de voir la pluralit\'e des acteurs et des contextes de socialisation en son sein comme les possibles inflexions qui peuvent survenir au fil de la carri\`ere des individus en fonction d'\'ev\'enements particuliers ou d'accidents biographiques.},
  copyright = {\copyright{} tous droits r\'eserv\'es},
  langid = {french},
  keywords = {Dispositions,Genre,Medecine,Professions,Socialisation}
}


@article{foxAdaptationLowLevels2015,
  title = {Adaptation to Low Levels of Chemical Exposure in Individuals with Multiple Chemical Sensitivity in a Controlled Indoor Environment},
  author = {Fox, R.A. and Sampalli, T.},
  year = 2015,
  journal = {Indoor and Built Environment},
  volume = {24},
  number = {5},
  pages = {713--721},
  issn = {1420326X (ISSN)},
  doi = {10.1177/1420326X14534094},
  abstract = {Environmental sensitivity or multiple chemical sensitivity (MCS) is a debilitating condition and increasingly prevalent in the recent years. MCS is a multisystem disorder with lack of standardized treatment strategies and clinical practice guidelines. Consequently, there are significant costs associated with disability and treating individuals with an increasing percentage of the population experiencing challenges in indoor environments from exposure to everyday chemicals such as personal care products. MCS remains a poorly understood condition with many challenges in establishing evidence to support the reactivity to the indoor environment experienced in individuals. This research attempts to validate the physiological reactivity and adaptation to everyday chemicals in a controlled environment in a sample of individuals (n = 90) with MCS. Sixty percent of the female and 40\% of the male subjects demonstrated confirmed physiological reactivity to the test substance. The results from this study indicate that the multifaceted nature of this condition possibly goes beyond the reactivity to chemicals in the environment. Further research is essential to understand the implications of hypersensitivity to help individuals optimally manage their health. \copyright{} The Author(s) 2014.},
  langid = {english},
  keywords = {adaptation,adult,age distribution,aged,Article,controlled study,environmental disease,environmental exposure,environmental parameters,female,Heightened sensitivity,human,hypersensitivity,major clinical study,male,Multiple chemical sensitivity,physiological process,priority journal,Reactivity to chemicals,sex difference,skin conductance,volatile organic compound}
}


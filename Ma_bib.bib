@techreport{ipbes_africa_2018,
  title = {The {{IPBES}} Regional Assessment Report on Biodiversity and Ecosystem Services for {{Africa}}},
  author = {{Intergovernmental Science-Policy Platform on Biodiversity {and} Ecosystem Services, IPBES.}},
  year = 2018,
  month = mar,
  institution = {Zenodo},
  doi = {10.5281/ZENODO.3236178},
  urldate = {2021-09-16},
  abstract = {The Regional Assessment Report on Biodiversity and Ecosystem Services for Africa produced by the Intergovernmental Science-Policy Platform on Biodiversity and Ecosystem Services (IPBES) provides a critical analysis of the state of knowledge regarding the importance, status, and trends of biodiversity and nature's contributions to people. The assessment analyses the direct and underlying causes for the observed changes in biodiversity and in nature's contributions to people, and the impact that these changes have on the quality of life of people. The assessment, finally, identifies a mix of governance options, policies and management practices that are currently available to reduce the loss of biodiversity and of nature's contributions to people in that region. The assessment addresses terrestrial, freshwater, and coastal biodiversity and covers current status and trends, going back in time several decades, and future projections, with a focus on the 2020-2050 period. The summary for policymakers of this Assessment Report was approved by the sixth session of the Plenary of IPBES (Medell\'in, Colombia, 18-24 March 2018) and is included in this report.},
  copyright = {Creative Commons Attribution 4.0 International, Open Access},
  langid = {english},
  keywords = {Africa Assessment,Full assessment report,IPBES,Regional assessment}
}


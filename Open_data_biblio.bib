@misc{institutpasteurModeleLogigrammeLInstitut2022,
  title = {{Mod\`ele de logigramme de l'Institut Pasteur relatif aux questions juridiques li\'ees \`a la r\'eutilisation des donn\'ees de la recherche}},
  editor = {{Institut Pasteur}},
  year = 2022,
  month = feb,
  urldate = {2023-10-19},
  abstract = {CONTEXTE : Dans le cadre de son plan strat\'egique 2019-2023, l'Institut Pasteur s'est donn\'e pour objectif de << favoriser l'acc\`es ouvert aux donn\'ees de la recherche >> et s'est dot\'e d'une politique de gestion et partage des donn\'ees de la recherche et codes logiciels (``RDM Policy''). Cette politique est entr\'ee en vigueur le 1er mai 2021 et est accessible ici : https://www.pasteur.fr/fr/file/40521/download. La politique ``RDM Policy'' s'est accompagn\'ee d'outils et fiches pratiques, ainsi que de nouvelles mesures concernant les plans de gestion des donn\'ees (PGD) sur la base desquels une identification des diff\'erents types de donn\'ees de la recherche, et une analyse pr\'ealable des questions juridiques qui y sont li\'ees, peuvent \^etre r\'ealis\'ees avant toute diffusion ou r\'eutilisation. A ce titre, les scientifiques sont encourag\'es \`a r\'eutiliser des donn\'ees existantes avant de cr\'eer leurs propres donn\'ees. L'enjeu de la r\'eutilisation de ces donn\'ees de recherche est crucial et impose aux scientifiques de se poser quelques questions pour v\'erifier que la r\'eutilisation se fait bien dans le respect du cadre juridique en vigueur applicable. OBJECTIF : Dans l'objectif d'accompagner les scientifiques tout au long de leurs projets de recherche, nous avons \'etabli un mod\`ele de logigramme qui \'enum\`ere les principales questions juridiques \`a se poser avant de r\'eutiliser un jeu de donn\'ees, les r\`egles \`a respecter dans chaque cas ainsi que les \'equipes support r\'ef\'erentes. Nous le proposons aujourd'hui \`a la diffusion dans un effort de mutualisation des moyens op\'erationnels et bonnes pratiques dans le monde de la recherche. Nous attirons votre attention sur le fait que l'objectif de ce mod\`ele est de fournir un outil au service des scientifiques d'aide \`a l'orientation. Il n'est pas destin\'e \`a \^etre utilis\'e comme un outil autonome pour la prise de d\'ecisions. De ce fait, les scientifiques sont encourag\'es \`a demander conseil aux \'equipes support concern\'ees. VOIR AUSSI : Mod\`ele de logigramme de l'Institut Pasteur relatif aux questions juridiques li\'ees \`a la diffusion des donn\'ees de la recherche. https://hal-pasteur.archives-ouvertes.fr/pasteur-03587216},
  langid = {french}
}

